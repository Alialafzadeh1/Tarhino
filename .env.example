# GEMINI_API_KEY: Direct Gemini API key has been removed from the Android client.
# In accordance with Tarhi Noo Phase 9.8 architecture, all Gemini AI interactions route exclusively
# through the secure Backend AI Gateway (/ai/chat). The Gemini API key is stored only on the backend.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# TARHI NOO REAL BACKEND & REALTIME CONFIGURATION (PHASE 9)
# The Android client only contains public/client configuration.
# Never put database admin keys, service-role keys or backend master secrets here.
BACKEND_BASE_URL=NOT_CONFIGURED
REALTIME_URL=NOT_CONFIGURED
STORAGE_URL=NOT_CONFIGURED
PUBLIC_APP_ID=NOT_CONFIGURED
PUBLIC_CLIENT_KEY=NOT_CONFIGURED
