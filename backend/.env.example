# =================================================================
# TARHI NOO BACKEND ENVIRONMENT CONFIGURATION (.env.example)
# Provider-independent configuration for VPS / Railway / Render / Fly.io / Docker
# =================================================================

NODE_ENV=production
PORT=8080
HOST=0.0.0.0

# DATABASE (PostgreSQL)
POSTGRES_USER=tarhinoo_user
POSTGRES_PASSWORD=replace_with_strong_database_password
POSTGRES_DB=tarhinoo_db
DATABASE_URL="postgresql://tarhinoo_user:replace_with_strong_database_password@localhost:5432/tarhinoo_db?schema=public"

# AUTHENTICATION & SECURITY
JWT_SECRET=replace_with_64_char_random_cryptographic_secret_key
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET=replace_with_64_char_random_refresh_secret_key
JWT_REFRESH_EXPIRES_IN="30d"

# REALTIME / WEBSOCKET
REALTIME_WS_PORT=8080
REALTIME_HEARTBEAT_SEC=25

# OBJECT STORAGE (S3 / MinIO Compatible)
S3_ENDPOINT="https://s3.eu-central-1.amazonaws.com"
S3_REGION="eu-central-1"
S3_BUCKET_NAME="tarhinoo-media-assets"
S3_ACCESS_KEY_ID="replace_with_storage_access_key"
S3_SECRET_ACCESS_KEY="replace_with_storage_secret_key"
STORAGE_PUBLIC_URL="https://storage.tarhinoo.com"

# UPLOAD SIZE LIMITS (Megabytes)
MAX_UPLOAD_IMAGE_MB=15
MAX_UPLOAD_VIDEO_MB=100
MAX_UPLOAD_AUDIO_MB=25
MAX_UPLOAD_VOICE_MB=25
MAX_UPLOAD_FILE_MB=50

# AI SERVICE GATEWAY (Server-side only — never leaked to Android APK)
GEMINI_API_KEY="replace_with_gemini_api_key_for_server"
OPENAI_API_KEY=""
AI_DEFAULT_PROVIDER="gemini"

# PUSH NOTIFICATIONS (Firebase Cloud Messaging)
FIREBASE_PROJECT_ID="replace_with_firebase_project_id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@replace_with_firebase_project_id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="replace_with_firebase_private_key"

# CORS & CLIENT WHITELIST (Explicit whitelist for production, e.g. https://app.tarhinoo.com)
ALLOWED_ORIGINS="https://app.tarhinoo.com"
